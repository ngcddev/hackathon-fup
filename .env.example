NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo desarrollo: usuario falso sin Supabase Auth (nunca en producción). Con la sesión real déjalo vacío.
# AUTH_STUB=true habilita el stub; AUTH_STUB_ROLE: director | service_head | medic | admin
AUTH_STUB=
AUTH_STUB_ROLE=

# Solo servidor (sin prefijo NEXT_PUBLIC_): clave de servicio y datos del primer admin (scripts/bootstrap-admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Usuarios demo por rol (scripts/seed/seed-users.ts). Solo servidor; nunca NEXT_PUBLIC_.
SEED_DIRECTOR_EMAIL=
SEED_DIRECTOR_PASSWORD=
SEED_DIRECTOR_NAME=
SEED_SERVICE_HEAD_EMAIL=
SEED_SERVICE_HEAD_PASSWORD=
SEED_SERVICE_HEAD_NAME=
SEED_MEDIC_EMAIL=
SEED_MEDIC_PASSWORD=
SEED_MEDIC_NAME=

# Carga histórica del HIS (solo en tu máquina; nunca en Vercel)
HIS_LOAD_DATABASE_URL=
HIS_DATA_DIR=
REFERENCE_DATE=
HIS_ENCODING=
HIS_SEPARATOR=

# Conexiones pg por rol, por el pooler de Supabase en modo transaction (puerto 6543).
# Usuario con formato rol.referencia_del_proyecto. Solo servidor; nunca NEXT_PUBLIC_.
DATABASE_URL_APP_BACKEND=
DATABASE_URL_AGENT_RO=
DATABASE_URL_IMPORTER=

# Agente (POST /api/query). Con AGENT_LLM_ENABLED=true usa Gemini (principal) y Groq (respaldo); sin él, va directo al plan B.
# Solo servidor (sin prefijo NEXT_PUBLIC_). Llaves: aistudio.google.com/apikey y console.groq.com/keys.
# Modelos gratuitos sugeridos: GEMINI_MODEL=gemini-3.1-flash-lite, GROQ_MODEL=openai/gpt-oss-20b
AGENT_LLM_ENABLED=
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=
